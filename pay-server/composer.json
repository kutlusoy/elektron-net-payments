{
    "name": "elektron-net/pay-server",
    "description": "Standalone, self-hostable payment server (pay-api and pay-watcher) built on elektron-net/payments-core. See doc-elektron/guideline-standalone-payment-server.md.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "elektron-net/payments-core": "*",
        "lastguest/murmurhash": "2.1.1 as 2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ElektronNet\\Payments\\PayServer\\": "api/src/",
            "ElektronNet\\Payments\\PayWatcher\\": "watcher/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElektronNet\\Payments\\PayServer\\Tests\\": "api/tests/"
        }
    }
}
