# Copy to pay-api.env and fill in real values. Never commit the filled-in file.

PAY_SERVER_NETWORK=mainnet
PAY_SERVER_DB_DSN=pgsql:host=db;port=5432;dbname=pay_server
PAY_SERVER_DB_USER=pay_server
PAY_SERVER_DB_PASSWORD=change-me

# Section 20: single server-wide flag, default false. Launch scope is
# direct payments only.
PAY_SERVER_ESCROW_ENABLED=false

PAY_SERVER_CHECKOUT_BASE_URL=https://pay.elektron-net.org

# Optional: JSON array overriding section 7's default three-endpoint list.
# PAY_SERVER_CHAIN_ENDPOINTS=[{"type":"esplora","base_url":"https://mempool.elektron-net.org/api"}]
