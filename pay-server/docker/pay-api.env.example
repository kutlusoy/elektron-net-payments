# Copy to pay-api.env and fill in real values. Never commit the filled-in file.

PAY_SERVER_NETWORK=mainnet
PAY_SERVER_DB_DSN=pgsql:host=db;port=5432;dbname=pay_server
PAY_SERVER_DB_USER=pay_server
PAY_SERVER_DB_PASSWORD=change-me

# Section 20: single server-wide flag, default false. Launch scope is
# direct payments only.
PAY_SERVER_ESCROW_ENABLED=false

PAY_SERVER_CHECKOUT_BASE_URL=https://pay.elektron-net.org

# Optional: JSON array overriding section 7's default three-endpoint list.
# PAY_SERVER_CHAIN_ENDPOINTS=[{"type":"esplora","base_url":"https://mempool.elektron-net.org/api"}]

# Optional, empty by default (section 12): JSON array of "simple price"
# style price-feed endpoints (CoinGecko-shaped, see
# https://docs.coingecko.com/demo/reference/simple-price), tried in order.
# ELEK is not listed on any platform today, so base_url and coin_id are
# left for the operator to point at whatever actually serves it (a
# self-hosted mirror, a private index, or a public one once ELEK is
# listed) - nothing here is CoinGecko-exclusive, any endpoint returning
# the same {"<coin_id>": {"<currency>": <number>}} shape works, and
# several entries here (even across different platforms) are tried in
# order until one has a rate.
# PAY_SERVER_PRICE_FEED_ENDPOINTS=[{"type":"simple_price","base_url":"https://api.coingecko.com/api/v3","coin_id":"elektron-net"}]
# A CoinGecko demo-tier key, if the endpoint requires one:
# PAY_SERVER_PRICE_FEED_ENDPOINTS=[{"type":"simple_price","base_url":"https://api.coingecko.com/api/v3","coin_id":"elektron-net","api_key_header":"x-cg-demo-api-key","api_key":"your-demo-key"}]
