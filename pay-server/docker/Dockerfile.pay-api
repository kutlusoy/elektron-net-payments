FROM php:8.2-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip git libgmp-dev \
    && docker-php-ext-install gmp \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY core ./core
COPY pay-server ./pay-server

WORKDIR /app/pay-server
RUN composer install --no-dev --optimize-autoloader --no-interaction

EXPOSE 8080

# Not optional: the checkout page's SSE connections (GET /v1/orders/{id}/events)
# stay open for minutes at a time, and PHP's built-in server handles one
# request at a time per worker -- without this, one open SSE connection
# would block every other request (REST API, admin UI, other checkout
# pages) on this container. A production deployment fronting pay-api with
# PHP-FPM behind nginx/Apache instead would not need this, but the
# built-in server is what this image uses for its own simplicity.
ENV PHP_CLI_SERVER_WORKERS=4

CMD ["php", "-S", "0.0.0.0:8080", "-t", "api/public"]
