# Copy to pay-watcher.env and fill in real values. Never commit the filled-in file.

PAY_SERVER_NETWORK=mainnet
PAY_SERVER_DB_DSN=pgsql:host=db;port=5432;dbname=pay_server
PAY_SERVER_DB_USER=pay_server
PAY_SERVER_DB_PASSWORD=change-me

# Section 6 checklist: poll interval and batch size MUST be configurable.
PAY_WATCHER_POLL_INTERVAL_SECONDS=30
PAY_WATCHER_BATCH_SIZE=100

