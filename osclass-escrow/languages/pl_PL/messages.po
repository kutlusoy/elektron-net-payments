msgstr ""
"Project-Id-Version: osclass-escrow 0.1\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pl_PL\n"

msgid "Buy with Elektron (ELEK)"
msgstr "Kup za Elektron (ELEK)"

msgid "View your Elektron order"
msgstr "Zobacz swoje zamówienie Elektron"

msgid "Please log in to buy with Elektron."
msgstr "Zaloguj się, aby kupić za Elektron."

msgid "This listing does not exist."
msgstr "To ogłoszenie nie istnieje."

msgid "You cannot buy your own listing."
msgstr "Nie możesz kupić własnego ogłoszenia."

msgid "Connect an Elektron Net wallet to your account first (see your profile settings), then come back to this listing."
msgstr "Najpierw połącz portfel Elektron Net ze swoim kontem (zobacz ustawienia profilu), a następnie wróć do tego ogłoszenia."

msgid "The seller has not connected an Elektron Net wallet yet, so this listing cannot be bought with escrow right now."
msgstr "Sprzedawca nie połączył jeszcze portfela Elektron Net, więc tego ogłoszenia nie można teraz kupić przez escrow."

msgid "Order not found."
msgstr "Nie znaleziono zamówienia."

msgid "Receipt confirmed."
msgstr "Odbiór potwierdzony."

msgid "Release PSBT construction is not implemented yet in this draft; nothing has actually moved on chain."
msgstr "Tworzenie PSBT zwolnienia środków nie zostało jeszcze zaimplementowane w tej wersji roboczej; nic faktycznie nie zostało przesłane w łańcuchu bloków."

msgid "Elektron order"
msgstr "Zamówienie Elektron"

msgid "Confirm receipt"
msgstr "Potwierdź odbiór"

msgid "Elektron Net public key (for escrow payments)"
msgstr "Klucz publiczny Elektron Net (do płatności escrow)"

msgid "Paste the public key from your Elektron Net wallet, never a private key or seed phrase. Needed once, before you can buy or sell with escrow."
msgstr "Wklej klucz publiczny ze swojego portfela Elektron Net, nigdy klucz prywatny ani frazę seed. Potrzebne jednorazowo, zanim będzie można kupować lub sprzedawać przez escrow."

msgid "The Elektron Net public key looks invalid (expected a 33-byte compressed key, 66 hex characters starting with 02 or 03) and was not saved."
msgstr "Klucz publiczny Elektron Net wygląda na nieprawidłowy (oczekiwano skompresowanego klucza 33-bajtowego, 66 znaków szesnastkowych zaczynających się od 02 lub 03) i nie został zapisany."

msgid "Elektron Net Escrow"
msgstr "Elektron Net Escrow"

msgid "Elektron Net Escrow settings"
msgstr "Ustawienia Elektron Net Escrow"

msgid "Elektron Net Escrow settings updated"
msgstr "Zaktualizowano ustawienia Elektron Net Escrow"

msgid "Network"
msgstr "Sieć"

msgid "Chain-data endpoints (one per line, tried in order)"
msgstr "Punkty dostępu do danych łańcucha (po jednym w wierszu, próbowane po kolei)"

msgid "Esplora/mempool-compatible base URLs, e.g. https://mempool.elektron-net.org/api"
msgstr "Adresy bazowe zgodne z Esplora/mempool, np. https://mempool.elektron-net.org/api"

msgid "Confirmations required before an order is \"funded\""
msgstr "Liczba potwierdzeń wymagana, zanim zamówienie zostanie uznane za \"opłacone\""

msgid "Release transaction fee rate (lep/vByte)"
msgstr "Stawka opłaty transakcji zwolnienia (lep/vByte)"

msgid "Buyer refund threshold, T1 (days)"
msgstr "Próg zwrotu dla kupującego, T1 (dni)"

msgid "Seller release threshold, T2 (days)"
msgstr "Próg zwolnienia dla sprzedawcy, T2 (dni)"

msgid "T2 must be at least %sx T1; see the plugin README, \"Escrow timeout policy\", for why."
msgstr "T2 musi wynosić co najmniej %sx T1; zobacz README wtyczki, \"Escrow timeout policy\", aby poznać powód."

msgid "Save"
msgstr "Zapisz"

msgid "Send {amount} ELEK to the address below to start this order."
msgstr "Wyślij {amount} ELEK na poniższy adres, aby rozpocząć to zamówienie."

msgid "Payment seen, waiting for {confirmations} confirmation(s)."
msgstr "Płatność wykryta, oczekiwanie na {confirmations} potwierdzenie(a)."

msgid "Payment confirmed. Please confirm receipt once the item arrives."
msgstr "Płatność potwierdzona. Potwierdź odbiór, gdy przedmiot dotrze."

msgid "Payment confirmed. Waiting for the buyer to confirm receipt."
msgstr "Płatność potwierdzona. Oczekiwanie na potwierdzenie odbioru przez kupującego."

msgid "Automatic refund available from {date} if this order is not confirmed before then."
msgstr "Automatyczny zwrot dostępny od {date}, jeśli to zamówienie nie zostanie wcześniej potwierdzone."

msgid "Automatic release available from {date} if the buyer does not respond."
msgstr "Automatyczne zwolnienie środków dostępne od {date}, jeśli kupujący nie odpowie."

msgid "Buyer confirmed receipt. Waiting for the seller's wallet to sign the release."
msgstr "Kupujący potwierdził odbiór. Oczekiwanie, aż portfel sprzedawcy podpisze zwolnienie środków."

msgid "Funds released to the seller."
msgstr "Środki zostały zwolnione dla sprzedawcy."

msgid "Funds refunded to the buyer."
msgstr "Środki zostały zwrócone kupującemu."

msgid "Funds claimed by the seller after the buyer did not respond in time."
msgstr "Środki zostały odebrane przez sprzedawcę, ponieważ kupujący nie odpowiedział na czas."

msgid "Your automatic refund window opens on {date} if this order stays unconfirmed."
msgstr "Twoje okno automatycznego zwrotu otwiera się {date}, jeśli to zamówienie pozostanie niepotwierdzone."

msgid "Your automatic release window opens on {date} if the buyer does not respond."
msgstr "Twoje okno automatycznego zwolnienia środków otwiera się {date}, jeśli kupujący nie odpowie."
