"Content-Transfer-Encoding: 8bit\n"
"Language: ru_RU\n"

msgid "Buy with Elektron (ELEK)"
msgstr "Купить за Elektron (ELEK)"

msgid "View your Elektron order"
msgstr "Посмотреть ваш заказ Elektron"

msgid "Please log in to buy with Elektron."
msgstr "Пожалуйста, войдите в систему, чтобы купить через Elektron."

msgid "This listing does not exist."
msgstr "Это объявление не существует."

msgid "You cannot buy your own listing."
msgstr "Вы не можете купить собственное объявление."

msgid "Connect an Elektron Net wallet to your account first (see your profile settings), then come back to this listing."
msgstr "Сначала подключите кошелёк Elektron Net к своему аккаунту (см. настройки профиля), затем вернитесь к этому объявлению."

msgid "The seller has not connected an Elektron Net wallet yet, so this listing cannot be bought with escrow right now."
msgstr "Продавец ещё не подключил кошелёк Elektron Net, поэтому это объявление пока нельзя купить через escrow."

msgid "Order not found."
msgstr "Заказ не найден."

msgid "Receipt confirmed."
msgstr "Получение подтверждено."

msgid "Release PSBT construction is not implemented yet in this draft; nothing has actually moved on chain."
msgstr "Формирование PSBT для перевода средств пока не реализовано в этой черновой версии; в блокчейне ничего фактически не перемещалось."

msgid "Elektron order"
msgstr "Заказ Elektron"

msgid "Confirm receipt"
msgstr "Подтвердить получение"

msgid "Elektron Net public key (for escrow payments)"
msgstr "Публичный ключ Elektron Net (для escrow-платежей)"

msgid "Paste the public key from your Elektron Net wallet, never a private key or seed phrase. Needed once, before you can buy or sell with escrow."
msgstr "Вставьте публичный ключ из вашего кошелька Elektron Net, никогда не вставляйте приватный ключ или seed-фразу. Требуется один раз, прежде чем вы сможете покупать или продавать через escrow."

msgid "The Elektron Net public key looks invalid (expected a 33-byte compressed key, 66 hex characters starting with 02 or 03) and was not saved."
msgstr "Публичный ключ Elektron Net выглядит недействительным (ожидается сжатый 33-байтовый ключ, 66 шестнадцатеричных символов, начинающихся с 02 или 03), и он не был сохранён."

msgid "Elektron Net Escrow"
msgstr "Elektron Net Escrow"

msgid "Elektron Net Escrow settings"
msgstr "Настройки Elektron Net Escrow"

msgid "Elektron Net Escrow settings updated"
msgstr "Настройки Elektron Net Escrow обновлены"

msgid "Network"
msgstr "Сеть"

msgid "Chain-data endpoints (one per line, tried in order)"
msgstr "Конечные точки данных блокчейна (по одной на строку, пробуются по порядку)"

msgid "Esplora/mempool-compatible base URLs, e.g. https://mempool.elektron-net.org/api"
msgstr "Базовые URL, совместимые с Esplora/mempool, напр. https://mempool.elektron-net.org/api"

msgid "Confirmations required before an order is \"funded\""
msgstr "Количество подтверждений, необходимое для статуса заказа \"оплачен\""

msgid "Release transaction fee rate (lep/vByte)"
msgstr "Ставка комиссии транзакции перевода (lep/vByte)"

msgid "Buyer refund threshold, T1 (days)"
msgstr "Порог возврата средств покупателю, T1 (дней)"

msgid "Seller release threshold, T2 (days)"
msgstr "Порог перевода средств продавцу, T2 (дней)"

msgid "T2 must be at least %sx T1; see the plugin README, \"Escrow timeout policy\", for why."
msgstr "T2 должен быть не менее чем в %s раз больше T1; причина объясняется в README плагина, раздел \"Escrow timeout policy\"."

msgid "Save"
msgstr "Сохранить"

msgid "Send {amount} ELEK to the address below to start this order."
msgstr "Отправьте {amount} ELEK на указанный ниже адрес, чтобы начать этот заказ."

msgid "Payment seen, waiting for {confirmations} confirmation(s)."
msgstr "Платёж обнаружен, ожидание {confirmations} подтверждения(ий)."

msgid "Payment confirmed. Please confirm receipt once the item arrives."
msgstr "Платёж подтверждён. Подтвердите получение, как только товар прибудет."

msgid "Payment confirmed. Waiting for the buyer to confirm receipt."
msgstr "Платёж подтверждён. Ожидание подтверждения получения покупателем."

msgid "Automatic refund available from {date} if this order is not confirmed before then."
msgstr "Автоматический возврат средств станет доступен с {date}, если заказ не будет подтверждён раньше."

msgid "Automatic release available from {date} if the buyer does not respond."
msgstr "Автоматический перевод средств продавцу станет доступен с {date}, если покупатель не ответит."

msgid "Buyer confirmed receipt. Waiting for the seller's wallet to sign the release."
msgstr "Покупатель подтвердил получение. Ожидание подписи от кошелька продавца для перевода средств."

msgid "Funds released to the seller."
msgstr "Средства переведены продавцу."

msgid "Funds refunded to the buyer."
msgstr "Средства возвращены покупателю."

msgid "Funds claimed by the seller after the buyer did not respond in time."
msgstr "Средства получены продавцом после того, как покупатель не ответил вовремя."

msgid "Your automatic refund window opens on {date} if this order stays unconfirmed."
msgstr "Ваше окно автоматического возврата средств откроется {date}, если этот заказ останется неподтверждённым."

msgid "Your automatic release window opens on {date} if the buyer does not respond."
msgstr "Ваше окно автоматического перевода средств откроется {date}, если покупатель не ответит."
